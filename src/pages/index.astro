---
import Base from '../layouts/Base.astro';
import Greeting from '../components/Greeting.astro';
import Cat from '../components/Cat.astro';
import PencilCup from '../components/PencilCup.astro';
---
<Base title="一张乱桌子">
  <main style="padding:80px 64px;display:grid;gap:40px;justify-items:start">
    <Greeting size="lg" />
    <Cat size="lg" />
    <PencilCup variant="cup" />
    <PencilCup variant="dots" />
  </main>
</Base>
