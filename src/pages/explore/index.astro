---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Draft from '../../components/Draft.astro';
import SectionHead from '../../components/SectionHead.astro';
import { REPOS } from '../../data/repos.mjs';

// 实验类的仓库；描述沿用 README 原文。
const EXPERIMENTS = REPOS.filter((r) => ['ai-roundtable', 'prompt-me'].includes(r.name));
---
<Base title="可能会炸 · 探索" section="explore">
  <main class="page">
    <SectionHead emoji="rocket" title="可能会炸" label="探索" colorName="若竹">
      <Draft>还没想清楚的实验和半成品。有的能跑，有的只跑过一次。</Draft>
    </SectionHead>
    <div class="grid">
      {EXPERIMENTS.map((r, i) => (
        <Card href={r.url} color="var(--c-explore)" tilt={i % 2 ? 1.2 : -1.4}>
          <h2>{r.name}</h2>
          <p>{r.comment}</p>
        </Card>
      ))}
      <div class="wip">更多半成品施工中……</div>
    </div>
  </main>
</Base>

<style>
  .page { max-width: 1100px; margin: 0 auto; padding: 56px 32px 0; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 34px 28px; align-items: start; }
  h2 { font-size: 24px; font-family: var(--font-mono); margin-bottom: 8px; }
  p { color: #555; font-size: 15px; }
  .wip { border: 2.5px dashed var(--mute); border-radius: 14px; padding: 28px 18px; color: var(--mute); text-align: center; }
</style>
