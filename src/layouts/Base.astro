---
import 'lxgw-wenkai-webfont/lxgwwenkai-regular.css';
import '../styles/tokens.css';
import '../styles/base.css';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  section?: 'repos' | 'aesthetics' | 'explore' | 'notes' | 'about' | 'home';
  /** 首页自带底栏（首屏原则），传 false 关掉通用页脚 */
  footer?: boolean;
}
const { title, description = '一张乱桌子，摆着一些好玩的东西。', section = 'home', footer = true } = Astro.props;
const color = section === 'home' ? 'var(--hl)' : `var(--c-${section})`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- 系统开了「减弱动态效果」：把所有动态表情（含之后脚本换上的）换成单帧静态版 -->
    <script is:inline data-still-emoji>
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const still = (img) => {
          const s = img.getAttribute('src');
          if (s && /^\/emoji\/[0-9a-f_]+\.webp$/.test(s)) img.setAttribute('src', s.replace(/\.webp$/, '.still.webp'));
        };
        new MutationObserver((ms) => {
          for (const m of ms) {
            if (m.type === 'attributes') still(m.target);
            else for (const n of m.addedNodes) if (n.nodeType === 1) { if (n.tagName === 'IMG') still(n); n.querySelectorAll('img').forEach(still); }
          }
        }).observe(document.documentElement, { subtree: true, childList: true, attributes: true, attributeFilter: ['src'] });
      }
    </script>
  </head>
  <body data-section={section} style={`--c: ${color}`}>
    <slot />
    {footer && <div class="footer-wrap"><SiteFooter /></div>}
  </body>
</html>

<style>
  .footer-wrap { max-width: 1100px; margin: 0 auto; padding: 0 32px; }
</style>
