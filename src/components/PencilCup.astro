---
import { PALETTE } from '../lib/accent.mjs';
import { emojiSrc } from '../data/emoji.mjs';

interface Props {
  variant: 'cup' | 'dots';
}
const { variant } = Astro.props;
const heights = [86, 100, 72, 94, 80, 90, 76, 68];
---
<div class:list={['palette', variant]} data-palette data-sparkle={emojiSrc('sparkles')}>
  {variant === 'cup' ? (
    <div>
      <div class="pens">
        {PALETTE.map((c, i) => (
          <button type="button" class="pen" data-hex={c.hex} data-name={c.name} title={`换成${c.name}`} style={`background:${c.hex};height:${heights[i] * 0.72}px`}></button>
        ))}
      </div>
      <div class="cupbody" data-label>{PALETTE[0].name} · {PALETTE[0].hex}</div>
    </div>
  ) : (
    PALETTE.map((c) => (
      <button type="button" class="dot" data-hex={c.hex} data-name={c.name} title={`换成${c.name}`} style={`background:${c.hex}`}></button>
    ))
  )}
</div>

<style>
  .palette button { border: 0; padding: 0; cursor: pointer; }
  .dots { display: flex; gap: 6px; align-items: center; }
  .dot { width: 12px; height: 12px; border-radius: 50%; outline: 1px solid rgba(0, 0, 0, 0.15); transition: transform 0.2s; }
  .dot:hover, .dot:focus-visible { transform: scale(1.35); }
  .pens { display: flex; gap: 5px; align-items: flex-end; height: 72px; padding: 0 12px; }
  .pen { width: 16px; border: 2px solid var(--ink) !important; border-bottom: 0 !important; border-radius: 8px 8px 0 0; transition: transform 0.2s; }
  .pen:hover, .pen:focus-visible { transform: translateY(-10px); }
  .cupbody {
    width: 170px; height: 34px; background: var(--card);
    border: 2.5px solid var(--ink); border-top-width: 4px; border-radius: 0 0 18px 18px;
    display: flex; align-items: center; justify-content: center; font: 12px var(--font-mono); color: #666;
  }
  :global(.sparkle) { position: fixed; width: 56px; height: 56px; pointer-events: none; z-index: 10; }
</style>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-palette]')) {
    const label = box.querySelector('[data-label]');
    box.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-hex]');
      if (!b) return;
      document.documentElement.style.setProperty('--hl', b.dataset.hex!);
      if (label) label.textContent = `${b.dataset.name} · ${b.dataset.hex}`;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const r = b.getBoundingClientRect();
      const s = Object.assign(document.createElement('img'), { src: box.dataset.sparkle, alt: '', className: 'sparkle' });
      Object.assign(s.style, { left: `${r.left + r.width / 2 - 28}px`, top: `${r.top - 60}px` });
      document.body.append(s);
      setTimeout(() => s.remove(), 1400);
    });
  }
</script>
